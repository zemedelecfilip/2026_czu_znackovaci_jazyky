{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Events List Schema",
  "type": "object",
  "required": ["page", "pageSize", "totalItems", "items"],
  "properties": {
    "page": { "type": "integer" },
    "pageSize": { "type": "integer" },
    "totalItems": { "type": "integer" },
    "totalPages": { "type": "integer" },
    "filters": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "day", "start", "performerId", "venueId"],
        "properties": {
          "id": { "type": "string" },
          "day": { "type": "string" },
          "theme": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "performerId": { "type": "string" },
          "venueId": { "type": "string" }
        }
      }
    }
  }
}