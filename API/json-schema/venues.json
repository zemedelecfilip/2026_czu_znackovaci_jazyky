{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venues List",
  "description": "Seznam všech scén na festivalu",
  "type": "object",
  "required": ["count", "items"],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "capacity"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}